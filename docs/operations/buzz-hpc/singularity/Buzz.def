Bootstrap: docker
From: ubuntu:24.04

%labels
    Application "Buzz Desktop + Local ACP"
    Distribution "Ubuntu 24.04 Noble"
    Purpose "NFS-shared X11 Desktop, Codex/Claude ACP, UTF-8 and IBus/Hangul"

%files
    # Operator stages BOTH verified assets beside Buzz.def.
    # Official Buzz Desktop deb package, renamed from the release filename.
    Buzz.deb /tmp/Buzz.deb
    # Verified https://nodejs.org/dist/v24.18.0/node-v24.18.0-linux-x64.tar.xz
    node-v24.18.0-linux-x64.tar.xz /tmp/node.tar.xz

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Etc/UTC

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates bash curl git openssh-client python3 jq ripgrep \
        xdg-utils locales \
        libffi8 libgtk-3-0 libwebkit2gtk-4.1-0 libayatana-appindicator3-1 \
        libsecret-1-0 libdbus-1-3 libnss3 libgl1 libegl1 libgbm1 \
        gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
        fonts-dejavu-core fonts-noto-color-emoji fonts-noto-cjk fonts-nanum \
        ibus ibus-hangul dbus-user-session \
        /tmp/Buzz.deb

    # Generate real UTF-8 locales; export LANG alone is insufficient.
    sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
    sed -i 's/^# *ko_KR.UTF-8 UTF-8/ko_KR.UTF-8 UTF-8/' /etc/locale.gen
    locale-gen en_US.UTF-8 ko_KR.UTF-8

    # Stage pinned official Node 24 binary (no host Node/npm dependency).
    install -d -m 0755 /opt/node /opt/acp
    tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1
    export PATH="/opt/node/bin:/opt/acp/bin:$PATH"
    node --version | grep -Fx 'v24.18.0'
    npm --version

    # ACP adapters must be installed at image-build time, NOT npx at user login.
    # codex-acp bundles a matched @openai/codex dependency; install the same
    # Codex version globally too so Buzz auth/readiness can find `codex`.
    # claude-agent-acp uses Claude Agent SDK; CLI is installed for Buzz auth probe.
    npm install --global --prefix /opt/acp --no-audit --no-fund \
        @agentclientprotocol/codex-acp@2.2.2 \
        @openai/codex@0.160.1 \
        @agentclientprotocol/claude-agent-acp@0.94.0 \
        @anthropic-ai/claude-code@2.1.303

    for binary in codex-acp claude-agent-acp codex claude; do
        command -v "$binary" >/dev/null || { echo "Missing ACP/CLI: $binary" >&2; exit 1; }
    done

    # Never configure a shared API key or user identity in this immutable SIF.
    # For a private enterprise CA, extend %files with a company .crt and run
    # update-ca-certificates HERE rather than disabling TLS verification.
    test -x /usr/bin/buzz-desktop
    test -e /usr/lib/x86_64-linux-gnu/libffi.so.8
    if ldd /usr/bin/buzz-desktop | grep -q 'not found'; then
        ldd /usr/bin/buzz-desktop >&2
        exit 1
    fi
    rm -f /tmp/Buzz.deb /tmp/node.tar.xz
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH="/opt/node/bin:/opt/acp/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
    # No LC_ALL override here: the per-user X11 launcher forwards a valid
    # locale; %runscript validates it and otherwise uses en_US.UTF-8.
    export LANG="${LANG:-en_US.UTF-8}"
    export GDK_BACKEND="${GDK_BACKEND:-x11}"
    export GTK_IM_MODULE="${GTK_IM_MODULE:-ibus}"
    export QT_IM_MODULE="${QT_IM_MODULE:-ibus}"
    export XMODIFIERS="${XMODIFIERS:-@im=ibus}"

%runscript
    set -eu
    # Honor an inherited UTF-8 locale if actually generated in this image.
    candidate="${LC_ALL:-${LANG:-en_US.UTF-8}}"
    if ! LC_ALL="$candidate" locale charmap 2>/dev/null | grep -qi '^UTF-8
    # Only start ibus-daemon when explicitly requested; reusing a host daemon
    # through the bound session D-Bus is preferable. Avoid duplicate daemons.
    if [ "${BUZZ_START_IBUS:-0}" = "1" ]; then
        ibus-daemon -drx >/dev/null 2>&1 || true
    fi
    exec /usr/bin/buzz-desktop "$@"

%test
    test -x /usr/bin/buzz-desktop
    test -e /usr/lib/x86_64-linux-gnu/libffi.so.8
    ! ldd /usr/bin/buzz-desktop | grep -q 'not found'
    /opt/node/bin/node --version | grep -Fx 'v24.18.0'
    test -x /opt/acp/bin/codex-acp
    test -x /opt/acp/bin/claude-agent-acp
    test -x /opt/acp/bin/claude
    test -x /opt/acp/bin/codex
    LC_ALL=ko_KR.UTF-8 locale charmap | grep -qi '^UTF-8$'
; then
        candidate=en_US.UTF-8
    fi
    export LANG="$candidate"
    export LC_ALL="$candidate"
    # Only start ibus-daemon when explicitly requested; reusing a host daemon
    # through the bound session D-Bus is preferable. Avoid duplicate daemons.
    if [ "${BUZZ_START_IBUS:-0}" = "1" ]; then
        ibus-daemon -drx >/dev/null 2>&1 || true
    fi
    exec /usr/bin/buzz-desktop "$@"

%test
    test -x /usr/bin/buzz-desktop
    test -e /usr/lib/x86_64-linux-gnu/libffi.so.8
    ! ldd /usr/bin/buzz-desktop | grep -q 'not found'
    /opt/node/bin/node --version | grep -Fx 'v24.18.0'
    test -x /opt/acp/bin/codex-acp
    test -x /opt/acp/bin/claude-agent-acp
    test -x /opt/acp/bin/claude
    test -x /opt/acp/bin/codex
    LC_ALL=ko_KR.UTF-8 locale charmap | grep -qi '^UTF-8$'
