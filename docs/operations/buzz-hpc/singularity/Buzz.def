Bootstrap: docker
From: ubuntu:24.04

%labels
    Application "Buzz Desktop"
    Distribution "Ubuntu 24.04 (Noble)"
    Packaging "Official Buzz .deb repackaged for Singularity/Apptainer"
    IntendedUse "HPC Linux X session; local coding agents; NFS-shared SIF"

%files
    # Stage the verified official x86_64 package as ./Buzz.deb
    # in the directory where apptainer/singularity build runs.
    Buzz.deb /tmp/Buzz.deb

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Etc/UTC

    # All GUI/FFI dependencies are resolved in the SIF, not on X hosts.
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        bash \
        curl \
        git \
        openssh-client \
        python3 \
        jq \
        ripgrep \
        xdg-utils \
        libffi8 \
        libgtk-3-0 \
        libwebkit2gtk-4.1-0 \
        libayatana-appindicator3-1 \
        libsecret-1-0 \
        libdbus-1-3 \
        libnss3 \
        libgl1 \
        libegl1 \
        libgbm1 \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        fonts-dejavu-core \
        fonts-noto-color-emoji \
        /tmp/Buzz.deb

    test -x /usr/bin/buzz-desktop || { echo 'Expected /usr/bin/buzz-desktop in official .deb' >&2; exit 1; }
    ldconfig -p | grep -q 'libffi.so.8' || { echo 'libffi.so.8 absent in SIF' >&2; exit 1; }
    if ldd /usr/bin/buzz-desktop | grep -q 'not found'; then
        ldd /usr/bin/buzz-desktop >&2
        exit 1
    fi

    rm -f /tmp/Buzz.deb
    rm -rf /var/lib/apt/lists/*

%environment
    export LANG="${LANG:-C.UTF-8}"
    export GDK_BACKEND="${GDK_BACKEND:-x11}"
    # Do not use host LD_LIBRARY_PATH or invoke an AppImage.

%runscript
    exec /usr/bin/buzz-desktop "$@"

%test
    test -x /usr/bin/buzz-desktop
    test -e /usr/lib/x86_64-linux-gnu/libffi.so.8
    ! ldd /usr/bin/buzz-desktop | grep -q 'not found'
