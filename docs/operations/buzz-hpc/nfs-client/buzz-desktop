#!/usr/bin/env bash
# Buzz Linux X-session / NFS launcher. Does not execute an AppImage.
set -euo pipefail
umask 077

: "${BUZZ_NFS_ROOT:?source the site env.sh first}"
: "${BUZZ_RELAY_URL:?source the site env.sh first}"

if [[ -z "${DISPLAY:-}" ]]; then
  echo 'Buzz: DISPLAY is empty; X11 session or X11 forwarding is required.' >&2
  exit 2
fi
if [[ -n "${BUZZ_PRIVATE_KEY:-}" ]]; then
  echo 'Buzz: unset BUZZ_PRIVATE_KEY; use per-user Desktop identity.' >&2
  exit 2
fi

if command -v apptainer >/dev/null 2>&1; then
  engine=apptainer
elif command -v singularity >/dev/null 2>&1; then
  engine=singularity
else
  echo 'Buzz: neither apptainer nor singularity found.' >&2
  exit 2
fi

sif="${BUZZ_NFS_ROOT}/current/Buzz.sif"
[[ -r "$sif" ]] || { echo "Buzz: cannot read $sif" >&2; exit 2; }

# Inject selected session values after --cleanenv. User secrets belong
# outside the shared env.sh and SIF.
forward=(
  DISPLAY XAUTHORITY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS
  GDK_BACKEND BUZZ_RELAY_URL BUZZ_RELAY_HTTP
  BUZZ_AGENT_PROVIDER BUZZ_AGENT_MODEL
  OPENAI_COMPAT_API_KEY OPENAI_COMPAT_BASE_URL OPENAI_COMPAT_MODEL OPENAI_COMPAT_API
  HTTPS_PROXY HTTP_PROXY NO_PROXY
  GH_HOST GH_TOKEN GITHUB_TOKEN
  CLAUDE_CONFIG_DIR ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN
  ANTHROPIC_API_KEY ANTHROPIC_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL
  ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
  CODEX_HOME CODEX_API_KEY OPENAI_API_KEY DTGPT_API_KEY MODEL_PROVIDER
  NO_BROWSER RUST_LOG RUST_BACKTRACE
)
for name in "${forward[@]}"; do
  if [[ -v "$name" ]]; then
    export "APPTAINERENV_${name}=${!name}"
    export "SINGULARITYENV_${name}=${!name}"
  fi
done

binds=()
if [[ -d /tmp/.X11-unix ]]; then
  binds+=(--bind /tmp/.X11-unix:/tmp/.X11-unix)
fi
if [[ -n "${XDG_RUNTIME_DIR:-}" && -d "$XDG_RUNTIME_DIR" ]]; then
  binds+=(--bind "${XDG_RUNTIME_DIR}:${XDG_RUNTIME_DIR}")
fi
if [[ -n "${XAUTHORITY:-}" && -f "$XAUTHORITY" ]]; then
  case "$XAUTHORITY" in
    "$HOME"/*|/tmp/*|"${XDG_RUNTIME_DIR:-/run/nonexistent}"/*) ;;
    *) binds+=(--bind "$XAUTHORITY:$XAUTHORITY:ro") ;;
  esac
fi

# Default Singularity/Apptainer binds include HOME, CWD and /tmp.
# Additional project directories require an approved bind policy.
# Display the launcher default. Buzz can override this from saved workspace state.
printf 'Buzz: engine=%s, SIF=%s\n' "$engine" "$sif" >&2
printf 'Buzz: launch relay=%s (saved Buzz workspace may override)\n' "$BUZZ_RELAY_URL" >&2
if [[ -n "${OPENAI_COMPAT_BASE_URL:-}" ]]; then
  printf 'Buzz: buzz-agent model endpoint=%s\n' "$OPENAI_COMPAT_BASE_URL" >&2
fi
if [[ -n "${ANTHROPIC_BASE_URL:-}" ]]; then
  printf 'Buzz: Claude endpoint=%s\n' "$ANTHROPIC_BASE_URL" >&2
fi

# Desktop release builds often emit little to stdout/stderr. The optional
# user-private log captures what they do emit without writing to the SIF/NFS.
# Never enable shell set -x: that would disclose API keys in exported env.
if [[ "${BUZZ_DESKTOP_LOG_TO_FILE:-0}" == "1" ]]; then
  logdir="${XDG_STATE_HOME:-$HOME/.local/state}/buzz"
  mkdir -p -m 0700 "$logdir"
  logfile="$logdir/desktop-$(date +%Y%m%d-%H%M%S).log"
  printf 'Buzz: collecting launcher/stdout/stderr at %s\n' "$logfile" >&2
  "$engine" run --cleanenv "${binds[@]}" "$sif" "$@" 2>&1 | tee -a "$logfile"
  exit "${PIPESTATUS[0]}"
fi

exec "$engine" run --cleanenv "${binds[@]}" "$sif" "$@"
